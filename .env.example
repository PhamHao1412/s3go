# S3Go Environment Variables Configuration Template

# Server Port (default: 8080)
PORT=8080

# Secure AES-256-GCM encryption key. Must be exactly 32 characters in production!
S3GO_ENCRYPTION_KEY=your-32-character-encryption-key

# Database file location path (JSON fallback mode only)
DB_PATH=connections.json

# PostgreSQL Database Connection String (Optional)
# If set, S3Go will automatically store credentials in Postgres, enabling persistence on Render Free Tier!
# DATABASE_URL=postgres://user:password@hostname:port/dbname?sslmode=require

# IP Whitelist Firewall (Optional)
# Comma-separated list of public IP addresses authorized to access S3Go.
# If left empty, IP checking is skipped completely (local loopback 127.0.0.1/::1 is always whitelisted by default).
# ALLOWED_IPS=203.0.113.50,198.51.100.12


# Root Bypass Optimization (Optional)
# If configured, accessing this massive S3 bucket will instantly list only the specified folder
# at the root, completely bypassing timeouts.
BYPASS_BUCKET=your-massive-s3-bucket-name
BYPASS_FOLDER=your-bypass-target-folder
